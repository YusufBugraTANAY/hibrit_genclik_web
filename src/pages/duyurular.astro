---
import Layout from '../layouts/Layout.astro';
import announcements from '../data/announcements.json';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('nav.announcements')}>
  <div class="container mx-auto px-4 py-32 min-h-screen">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-deep mb-6">
        {t('nav.announcements')}
      </h1>
      <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
    </div>
    
    <div class="max-w-4xl mx-auto space-y-8">
      {announcements.map((announcement) => (
        <div class="glass-card p-8 md:p-10 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-primary"></div>
          <div class="text-primary text-sm font-bold mb-3 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            {new Date(announcement.date).toLocaleDateString(lang === 'tr' ? 'tr-TR' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-deep mb-6 leading-tight">
            {announcement.title[lang] || announcement.title.tr}
          </h2>
          <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed announcement-content" set:html={announcement.content[lang] || announcement.content.tr}></div>
        </div>
      ))}
    </div>
  </div>
</Layout>


