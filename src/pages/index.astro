---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import NewsCarousel from '../components/NewsCarousel.jsx';

import association from '../data/association.json';
import projects from '../data/projects.json';

import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout>
  <!-- Hero Section -->
  <Hero />
  <!-- Announcements Section -->
  <section class="py-12 bg-mint/10 border-b border-mint/20 relative z-10">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-deep flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          {t('nav.announcements')}
        </h2>
        <a href={translatePath('/duyurular/')} class="text-primary font-semibold hover:text-primary-dark transition-colors text-sm md:text-base">
          Tümünü Gör &rarr;
        </a>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 group hover:border-primary/30 transition-colors">
        <div>
          <span class="inline-block px-3 py-1 bg-red-100 text-red-600 rounded-full text-xs font-bold mb-3">YENİ DUYURU</span>
          <h3 class="text-xl font-bold text-slate-deep group-hover:text-primary transition-colors">Olağan Genel Kurul İlanı - Hibrit Gençlik Kulübü Derneği</h3>
          <p class="text-slate-600 mt-2 line-clamp-2 max-w-3xl">Derneğimizin Olağan Genel Kurul toplantısı 27.06.2026 tarihinde saat 10:00'da dernek merkez bürosunda yapılacaktır.</p>
        </div>
        <a href={translatePath('/duyurular/')} class="shrink-0 px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition-colors text-center shadow-md hover:shadow-lg">
          Detayları Oku
        </a>
      </div>
    </div>
  </section>

  <!-- News & Events Carousel Section -->
  <section class="py-24 relative relative z-10">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold text-slate-deep mb-4">{t('projects.title')} <span class="text-gradient">{t('projects.title.gradient')}</span></h2>
          <p class="text-slate-text max-w-2xl leading-relaxed">
            {t('projects.subtitle')}
          </p>
        </div>
        <a href={translatePath('/projeler/')} class="inline-flex items-center text-primary font-semibold hover:text-primary-dark transition-colors group">
          {t('projects.viewAll')}
          <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-2 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      
      <!-- Swiper Carousel Component (Client Load) -->
      <NewsCarousel projects={projects} lang={lang} client:load />
    </div>
  </section>



  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary/5"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="glass-card p-12 md:p-20 text-center border-slate-200 bg-white">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-deep mb-6">{t('cta.title')}</h2>
        <p class="text-lg text-slate-text max-w-2xl mx-auto mb-10">
          {t('cta.subtitle')}
        </p>
        <a href={translatePath('/gonulluluk/')} class="inline-block px-10 py-5 bg-primary hover:bg-primary-dark text-white font-bold rounded-full transition-all transform hover:scale-105 shadow-md text-lg">
          {t('cta.btn')}
        </a>
      </div>
    </div>
  </section>
</Layout>
